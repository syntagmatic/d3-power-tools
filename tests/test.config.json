    {
      "name": "a11y-keyboard-nav",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "setup": "document.querySelector('canvas').focus(); await new Promise(r => setTimeout(r, 200)); document.querySelector('canvas').dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); await new Promise(r => setTimeout(r, 200)); document.querySelector('canvas').dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); await new Promise(r => setTimeout(r, 200));",
