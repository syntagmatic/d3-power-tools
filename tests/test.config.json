    },
    {
      "name": "a11y-select",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "interactions": [
        "click"
      ],
      "setup": "document.querySelector('canvas').focus(); await new Promise(r => setTimeout(r, 200)); document.querySelector('canvas').dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); await new Promise(r => setTimeout(r, 200)); document.querySelector('canvas').dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter', bubbles: true})); await new Promise(r => setTimeout(r, 200));",
      "skill": "canvas-accessibility"
    },
    {
      "name": "a11y-focus-entry",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "setup": "const c = document.querySelector('canvas'); c.focus(); await new Promise(r => setTimeout(r, 300)); if (c.dataset.focusedId === '') throw new Error('Focus-on-entry failed: no focusedId after focus'); if (c.dataset.hasFocus !== 'true') throw new Error('hasFocus not set');",
      "skill": "canvas-accessibility"
    },
    {
      "name": "a11y-blur-clear",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "setup": "const c = document.querySelector('canvas'); c.focus(); await new Promise(r => setTimeout(r, 200)); c.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); await new Promise(r => setTimeout(r, 200)); const idBefore = c.dataset.focusedId; c.blur(); await new Promise(r => setTimeout(r, 200)); if (c.dataset.focusedId !== '') throw new Error('Blur-clear failed: focusedId should be empty after blur in clear mode, got ' + c.dataset.focusedId); if (c.dataset.hasFocus !== 'false') throw new Error('hasFocus should be false after blur');",
      "skill": "canvas-accessibility"
    },
    {
      "name": "a11y-blur-preserve",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "setup": "const c = document.querySelector('canvas'); document.querySelector('[data-action=toggle-blur-mode]').click(); await new Promise(r => setTimeout(r, 100)); c.focus(); await new Promise(r => setTimeout(r, 200)); c.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); await new Promise(r => setTimeout(r, 200)); const idBefore = c.dataset.focusedId; c.blur(); await new Promise(r => setTimeout(r, 200)); if (c.dataset.focusedId !== idBefore) throw new Error('Blur-preserve failed: focusedId changed from ' + idBefore + ' to ' + c.dataset.focusedId); if (c.dataset.hasFocus !== 'false') throw new Error('hasFocus should be false after blur');",
      "skill": "canvas-accessibility"
    },
    {
      "name": "a11y-blur-preserve-refocus",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "setup": "const c = document.querySelector('canvas'); document.querySelector('[data-action=toggle-blur-mode]').click(); await new Promise(r => setTimeout(r, 100)); c.focus(); await new Promise(r => setTimeout(r, 200)); c.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); await new Promise(r => setTimeout(r, 200)); const idBefore = c.dataset.focusedId; c.blur(); await new Promise(r => setTimeout(r, 200)); c.focus(); await new Promise(r => setTimeout(r, 200)); if (c.dataset.focusedId !== idBefore) throw new Error('Re-focus should restore same focusedId, got ' + c.dataset.focusedId + ' expected ' + idBefore); if (c.dataset.hasFocus !== 'true') throw new Error('hasFocus should be true after re-focus');",
      "skill": "canvas-accessibility"
    },
    {
      "name": "a11y-destroy-nav",
      "file": "skills/canvas-accessibility/examples/canvas-accessibility.html",
      "wait_for": "canvas",
      "setup": "document.querySelector('[data-action=destroy-nav]').click(); await new Promise(r => setTimeout(r, 200)); const c = document.querySelector('canvas'); if (c.dataset.navDestroyed !== 'true') throw new Error('navDestroyed not set'); if (c.hasAttribute('tabindex')) throw new Error('tabindex should be removed after destroy'); if (document.querySelector('[aria-live]')) throw new Error('Live region should be removed after destroy');",
      "skill": "canvas-accessibility"
    },
